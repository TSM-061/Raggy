# Optional for running Vite directly instead of using the existing nginx entrypoint.
# Point this to the nginx entrypoint that routes /api/auth, /api/uploads, /api/search.
API_PROXY_TARGET=http://localhost

# Optional, explicitly labelled sample-data preview. Makes no backend or AI calls.
VITE_DEMO_MODE=false

# Enable when Docker bind mounts do not deliver file-change events (Windows).
DEV_POLLING=false
