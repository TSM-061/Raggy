# goose settings
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:rag_password@localhost:5434/postgres
GOOSE_MIGRATION_DIR=./internal/migrations

# Set fake to run the real pipeline without external AI calls or a Gemini key.
AI_PROVIDER=gemini

# In fake mode, simulate this much processing time per chunk. Use 0s to disable.
FAKE_CHUNK_DELAY=1s

# Required only when AI_PROVIDER=gemini. Copy this file to .env to configure it.
GEMINI_API_KEY=
# Existing embeddings must use the same model and dimensions as query embeddings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_GENERATION_MODEL=gemini-3.5-flash
